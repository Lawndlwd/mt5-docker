# Copy to .env for local runs, or paste into Dokploy -> your compose service -> Environment.

# Number of MT5 terminals = number of requests served in parallel (1-8).
# Each terminal needs roughly 300-500 MB of the Windows RAM below.
MT5_INSTANCES=2

# If set, every /api/* request must send header  X-API-Key: <value>
GATEWAY_API_KEY=

# Windows VM resources
WINDOWS_RAM=6G
WINDOWS_CPUS=4
WINDOWS_DISK=64G
WINDOWS_VERSION=11l
# Change before the FIRST start (used by the unattended install; also the RDP login).
WINDOWS_USER=Docker
WINDOWS_PASSWORD=admin
# Optional Windows product key (otherwise Windows runs unactivated)
WINDOWS_KEY=

# Where the gateway is published on the host.
# Dokploy with a domain: set GATEWAY_BIND=127.0.0.1 so only Traefik exposes it.
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=8070

# Windows desktop web viewer (install progress / debugging). Keep on localhost.
VIEWER_BIND=127.0.0.1
VIEWER_PORT=8006

QUEUE_TIMEOUT=60
REQUEST_TIMEOUT=120
LOG_LEVEL=info
DOCKUR_TAG=6.05
